{
  "expo": {
    "name": "Bitescore",
    "slug": "bitescore",
    "scheme": "bitescore",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFDE59"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bitescore.app",
      "buildNumber": "21",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Bitescore uses your location to show hygiene ratings for places to eat near you."
      }
    },
    "android": {
      "package": "com.bitescore.app",
      "versionCode": 21,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFDE59"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-location",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "44efaf3a-a3d6-48f0-adee-e0bfa2637a8a"
      }
    },
    "owner": "dilagee",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/44efaf3a-a3d6-48f0-adee-e0bfa2637a8a",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
