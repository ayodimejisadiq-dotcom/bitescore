{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cron/ingest.ts": {
      "maxDuration": 60
    },
    "api/cron/notify.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/home"
    },
    {
      "source": "/privacy",
      "destination": "/api/privacy"
    },
    {
      "source": "/support",
      "destination": "/api/support"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/notify",
      "schedule": "0 * * * *"
    }
  ]
}
